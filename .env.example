# Copie para .env e preencha. Sem GEMINI_API_KEY o sistema funciona em modo degradado (sem agentes).
GEMINI_API_KEY=
# Modelo principal (Agente de Operações e Assistente) e modelo leve (Revisor)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
# Cadeia de fallback, usada quando o modelo principal responde 503/429 ou estoura o timeout
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
JWT_SECRET=troque-este-segredo
